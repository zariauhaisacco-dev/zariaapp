*.before-*

# Import scripts (contain client PII)
imports/
*.import.sql

# Test artifacts
cleanup-*.sql
fix-*.sql
rebuild-*.sql
recover-row-*.js
dry-run-*.js

# Scratch / temp SQL
/tmp/*.sql
*.sql.tmp

# Branding source files (raw originals — not served)
public/images/*-original.png
